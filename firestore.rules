rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owns(uid) { return request.auth != null && request.auth.uid == uid; }
  match /users/{uid} {
   allow read: if owns(uid);
   allow create, update: if owns(uid)
    && request.resource.data.keys().hasOnly(['name','goal','readAt','joinedAt'])
    && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
    && (request.resource.data.goal == null || (request.resource.data.goal is number && request.resource.data.goal > 0 && request.resource.data.goal <= 100000))
    && request.resource.data.readAt is number && request.resource.data.joinedAt is number;
   match /activities/{activityId} {
    allow read, delete: if owns(uid);
    allow create, update: if owns(uid)
     && request.resource.data.keys().hasOnly(['id','date','category','label','kg','createdAt','kind','factorVersion'])
     && request.resource.data.id == activityId
     && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
     && request.resource.data.category in ['Ulaşım','Beslenme','Ev']
     && request.resource.data.label is string && request.resource.data.label.size() > 0 && request.resource.data.label.size() <= 300
     && request.resource.data.kg is number && request.resource.data.kg >= 0 && request.resource.data.kg <= 1000000
     && request.resource.data.createdAt is number;
   }
   match /contributions/{entryId} {
    allow read, delete: if owns(uid);
    allow create, update: if owns(uid)
     && request.resource.data.keys().hasOnly(['id','date','title','kind','quantity','note','createdAt'])
     && request.resource.data.id == entryId
     && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
     && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
     && request.resource.data.kind in ['Fidan dikimi','Gönüllülük','Geri dönüşüm']
     && request.resource.data.quantity is number && request.resource.data.quantity > 0 && request.resource.data.quantity <= 100000
     && request.resource.data.note is string && request.resource.data.note.size() <= 500
     && request.resource.data.createdAt is number;
   }
  }
 }
}
